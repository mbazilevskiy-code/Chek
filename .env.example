# ===== Telegram =====

# Токен бота из @BotFather (Telegram), выглядит как 123456789:AAE...xyz
TELEGRAM_BOT_TOKEN=ВСТАВЬ_СЮДА_ТОКЕН_БОТА

# ===== ИИ для анализа еды: достаточно заполнить ОДИН из ключей =====

# Вариант 1 — БЕСПЛАТНО, карта не нужна: ключ с openrouter.ai (раздел Keys), sk-or-...
OPENROUTER_API_KEY=

# Вариант 2 — точнее всего, платно: ключ с console.anthropic.com (API Keys), sk-ant-...
ANTHROPIC_API_KEY=

# Если оба пустые — бот запустится в демо-режиме (без анализа еды).
# Если заполнены оба — бот выберет Claude.

# ===== Модели (можно не трогать) =====

# auto = бот сам подберёт у OpenRouter бесплатную модель с поддержкой фото
OPENROUTER_MODEL=auto
# Модель Claude: claude-sonnet-5 (точнее) или claude-haiku-4-5 (в ~3 раза дешевле)
MODEL=claude-sonnet-5

# ===== Дашборд =====

# Дашборд в браузере: http://localhost:8127 (пока бот запущен).
# Отключить: DASHBOARD=off. Поменять порт: DASHBOARD_PORT=8128
DASHBOARD=on
DASHBOARD_PORT=8127
# Ключ доступа извне (на сервере создаётся сам при деплое; на компьютере оставь пустым)
DASHBOARD_TOKEN=

# Публичный адрес, по которому бот доступен снаружи, например https://example.com
# (без слэша справа). Задан — все ссылки (дашборд, кабинет тренера) строятся от него.
# Пусто — как раньше: http://<адрес-сервера>:DASHBOARD_PORT
PUBLIC_BASE_URL=

# ===== Голосовой ввод (распознавание речи) — необязательно =====
# on — бот принимает голосовые и распознаёт их локально (faster-whisper).
# Модель качается один раз при первом голосовом. medium требует ~2 ГБ RAM.
VOICE_ENABLED=off
WHISPER_MODEL=medium
WHISPER_COMPUTE=int8
WHISPER_LANGUAGE=ru
# Голосовые длиннее этого — попросим покороче
VOICE_MAX_SECONDS=180

# ===== Oura (кольцо) — необязательно =====
# Зарегистрируй приложение на cloud.ouraring.com (для разработчиков), вставь сюда.
# Redirect URI должен совпадать с зарегистрированным: http://<IP-сервера>:8127/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=

# ===== Доступ =====

# Telegram ID через запятую, кому разрешён доступ.
# Пусто = бот привяжется к первому, кто ему напишет (то есть к тебе).
ALLOWED_USER_IDS=
